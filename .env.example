# Supabase — copy to .env.local and fill in values from Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Server-only — never expose to browser or commit to git
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Optional — for Supabase CLI / direct DB migrations (Settings → Database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
